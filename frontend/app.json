{
  "expo": {
    "name": "ReelDirector AI",
    "slug": "reeldirector-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reeldirector",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.reeldirector.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Record cinematic shots with AI guidance",
        "NSMicrophoneUsageDescription": "Capture audio with your video clips",
        "NSPhotoLibraryUsageDescription": "Save your finished reels",
        "NSPhotoLibraryAddUsageDescription": "Save your finished reels"
      }
    },
    "android": {
      "package": "com.reeldirector.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0B0E"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Record cinematic shots with AI guidance",
          "microphonePermission": "Capture audio with your video clips"
        }
      ],
      "expo-video",
      "expo-audio",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ReelDirector to save your finished videos.",
          "savePhotosPermission": "Allow ReelDirector to save your finished videos.",
          "granularPermissions": ["video"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
